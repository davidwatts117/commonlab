# Copy to worker/.env (ignored), chmod 600, and fill every required value.
CL_API_BASE_URL=
# Separate from ADMIN_TOKEN; use openssl rand -hex 32. Also set it on Axum.
GENERATION_WORKER_TOKEN=
# Explicit custom OpenAI-compatible provider; model IDs must be in worker/models.json.
CL_MODEL_PROVIDER=openrouter
CL_MODEL_ID=
CL_MODEL_API_KEY=
# off|minimal|low|medium|high|xhigh|max; must be supported by the selected model.
# Default low. DeepSeek Flash supports off, low, high, max.
CL_MODEL_REASONING_EFFORT=low
# Empty inherits the author setting. Mandatory-reasoning models use low for off.
CL_REVIEW_REASONING_EFFORT=
# Keep false publicly. true is an explicit private-network development opt-in.
CL_WORKER_ALLOW_HTTP=false
# Optional operator-only JSONL agent traces. Empty disables recording.
# With the supplied Compose files, enable using /var/lib/commonlab/agent-traces.
# This is a private named volume, never the app's public directory.
CL_AGENT_TRACE_DIR=
CL_AGENT_TRACE_MAX_FILES=50
CL_AGENT_TRACE_MAX_BYTES=8388608
CL_AGENT_TRACE_MAX_DAYS=7
# Required independent vision reviewer. Empty provider uses CL_MODEL_PROVIDER.
# Select an image-capable entry from worker/models.json; missing config fails preflight.
CL_REVIEW_MODEL_PROVIDER=
CL_REVIEW_MODEL_ID=
# Defaults to CL_MODEL_API_KEY when empty.
CL_REVIEW_MODEL_API_KEY=
# Must remain 1: verified mode requires screenshots for the reviewer.
CL_REVIEW_IMAGES=1
# Attach the same screenshots when the author model itself supports image input.
CL_AUTHOR_IMAGES=1
# Operational state, separate from optional transcripts. Mount worker-only volume here.
CL_CHECKPOINT_DIR=/var/lib/commonlab/checkpoints
