# Copy to worker/.env (ignored), chmod 600, and fill every required value.
CL_API_BASE_URL=
# Separate from ADMIN_TOKEN; use openssl rand -hex 32. Also set it on Axum.
GENERATION_WORKER_TOKEN=
# Providers: anthropic, openai, google, openrouter. No ambient pi credentials.
CL_MODEL_PROVIDER=
CL_MODEL_ID=
CL_MODEL_API_KEY=
# Keep false publicly. true is an explicit private-network development opt-in.
CL_WORKER_ALLOW_HTTP=false
# Optional operator-only JSONL agent traces. Empty disables recording.
# With the supplied Compose files, enable using /var/lib/commonlab/agent-traces.
# This is a private named volume, never the app's public directory.
CL_AGENT_TRACE_DIR=
CL_AGENT_TRACE_MAX_FILES=50
CL_AGENT_TRACE_MAX_BYTES=8388608
CL_AGENT_TRACE_MAX_DAYS=7
